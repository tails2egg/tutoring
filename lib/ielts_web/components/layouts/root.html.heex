<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Riyad" suffix=" · Riyad">{assigns[:page_title]}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      html,
      body {
        margin: 0;
        background: #071529;
      }

      body.splash-pending {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      body.welcome-active {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      body.transition-loading-active {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      #main-app-content {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      body.main-app-ready #main-app-content,
      body.main-app-visible #main-app-content {
        visibility: visible;
      }

      body.main-app-visible #main-app-content {
        opacity: 1;
        pointer-events: auto;
      }

      .startup-stage {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        margin: 0;
        padding: 0;
        overflow: hidden;
        transition: opacity 0.7s ease-in-out;
      }

      #app-transition-loading {
        display: grid;
        place-items: center;
        visibility: hidden;
        opacity: 0;
        background:
          radial-gradient(circle at 50% 42%, rgba(53, 167, 223, 0.18), transparent 36%),
          #071529;
        color: #ffffff;
        pointer-events: none;
        z-index: 25000;
      }

      #app-transition-loading.is-visible {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
      }

      #app-welcome-onboarding {
        visibility: visible;
        opacity: 0;
        background: #071529;
        pointer-events: none;
        z-index: 20000;
      }

      #app-welcome-onboarding.is-visible {
        opacity: 1;
        pointer-events: auto;
      }

      body.splash-pending #app-splash-screen,
      body.splash-active #app-splash-screen {
        visibility: visible;
        opacity: 1;
        background: #071529;
        z-index: 30000;
      }

      body.splash-pending #app-splash-screen .splash-scenes,
      body.splash-pending #app-splash-screen .splash-scene,
      body.splash-active #app-splash-screen .splash-scenes,
      body.splash-active #app-splash-screen .splash-scene {
        position: absolute;
        margin: 0;
        padding: 0;
      }

      body.splash-pending #app-splash-screen .splash-scenes,
      body.splash-active #app-splash-screen .splash-scenes {
        inset: 0;
        width: 100%;
        height: 100%;
      }

      body.splash-pending #app-splash-screen .splash-scene,
      body.splash-active #app-splash-screen .splash-scene {
        display: block;
        top: -4px;
        left: -4px;
        width: calc(100% + 8px);
        height: calc(100% + 8px);
        border: 0;
        object-fit: cover;
        object-position: center center;
        opacity: 0;
      }

      body.splash-pending #app-splash-screen .splash-scene.is-active,
      body.splash-active #app-splash-screen .splash-scene.is-active {
        opacity: 1;
      }

      body.splash-pending #app-splash-screen .splash-loading-ui,
      body.splash-active #app-splash-screen .splash-loading-ui {
        position: absolute;
        left: 50%;
        bottom: calc(env(safe-area-inset-bottom, 0px) + 2rem);
        z-index: 10;
        display: grid;
        width: min(78%, 320px);
        transform: translateX(-50%);
        justify-items: center;
        gap: 0.55rem;
        color: #ffffff;
        text-align: center;
      }

      body.splash-pending #app-splash-screen .splash-percent,
      body.splash-pending #app-splash-screen .splash-caption,
      body.splash-active #app-splash-screen .splash-percent,
      body.splash-active #app-splash-screen .splash-caption {
        margin: 0;
      }

      body.splash-pending #app-splash-screen .splash-progress-track,
      body.splash-active #app-splash-screen .splash-progress-track {
        width: 100%;
        max-width: 21rem;
        height: 12px;
        overflow: hidden;
        border: 2px solid rgba(255, 255, 255, 0.9);
        border-radius: 999px;
        background: rgba(15, 15, 15, 0.7);
      }

      body.splash-pending #app-splash-screen .splash-progress-fill,
      body.splash-active #app-splash-screen .splash-progress-fill {
        width: 0%;
        height: 100%;
        border-radius: inherit;
        background: #35A7DF;
      }
    </style>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div
      id="app-splash-screen"
      class="splash-screen startup-stage"
      data-splash-screen
      data-scene-count="10"
      role="status"
      aria-live="polite"
      aria-label="Loading IELTS Simplified"
    >
      <div class="splash-scenes" aria-hidden="true">
        <img
          class="splash-scene is-active"
          data-splash-scene="0"
          src={~p"/pic/splash/splash_01.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="1"
          src={~p"/pic/splash/splash_02.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="2"
          src={~p"/pic/splash/splash_03.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="3"
          src={~p"/pic/splash/splash_04.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="4"
          src={~p"/pic/splash/splash_05.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="5"
          src={~p"/pic/splash/splash_06.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="6"
          src={~p"/pic/splash/splash_07.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="7"
          src={~p"/pic/splash/splash_08.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="8"
          src={~p"/pic/splash/splash_09.png"}
          alt=""
        />
        <img
          class="splash-scene"
          data-splash-scene="9"
          src={~p"/pic/splash/splash_10.png"}
          alt=""
        />
      </div>

      <div class="splash-loading-ui">
        <p class="splash-percent" data-splash-percent>0%</p>
        <div class="splash-progress-track" aria-hidden="true">
          <div class="splash-progress-fill" data-splash-fill style="width: 0%"></div>
        </div>
        <p class="splash-caption" data-splash-caption>From preparation to celebration!</p>
      </div>
    </div>

    <div
      id="app-transition-loading"
      class="startup-stage"
      data-transition-loading
      hidden
      role="status"
      aria-live="polite"
      aria-label="Preparing IELTS Simplified"
      aria-hidden="true"
    >
      <div class="transition-loading-content">
        <p class="transition-loading-title">
          <span>IELTS</span>
          <span>SIMPLIFIED</span>
        </p>
        <div class="transition-loading-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <div
      id="app-welcome-onboarding"
      class="startup-stage"
      data-welcome-onboarding
      hidden
      aria-hidden="true"
    >
      <div class="welcome-art-stage">
        <div class="welcome-screen is-active" data-welcome-screen="0">
          <img class="welcome-screen-image" src={~p"/welcome.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="1">
          <img class="welcome-screen-image" src={~p"/welcome1.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="2">
          <img class="welcome-screen-image" src={~p"/welcome2.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="3">
          <img class="welcome-screen-image" src={~p"/welcome3.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="4">
          <img class="welcome-screen-image" src={~p"/welcome4.png"} alt="" draggable="false" />
          <div class="welcome-name-mask" aria-hidden="true"></div>
          <input
            id="welcome-name-input"
            type="text"
            autocomplete="name"
            maxlength="40"
            aria-label="اكتب اسمك هنا"
          />
          <span id="welcome-name-hint">اكتب اسمك هنا ..</span>
        </div>
        <div class="welcome-screen" data-welcome-screen="5">
          <img class="welcome-screen-image" src={~p"/welcome5.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="6">
          <img class="welcome-screen-image" src={~p"/welcome6.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="7">
          <img class="welcome-screen-image" src={~p"/welcome7.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="8">
          <img class="welcome-screen-image" src={~p"/welcome8.png"} alt="" draggable="false" />
        </div>
        <div class="welcome-screen" data-welcome-screen="9">
          <img class="welcome-screen-image" src={~p"/welcome9.png"} alt="" draggable="false" />
        </div>
      </div>

      <section
        id="ielts-goal-screen"
        class="ielts-goal-screen"
        data-ielts-goal-screen
        hidden
        aria-label="Choose IELTS goal scores"
      >
        <div class="goal-sky-cloud goal-sky-cloud-left" aria-hidden="true"></div>
        <div class="goal-sky-cloud goal-sky-cloud-right" aria-hidden="true"></div>
        <div class="goal-ground" aria-hidden="true"></div>

        <div class="goal-scroll">
          <div class="goal-phone-frame">
            <div class="goal-brand" aria-label="IELTS Simplified">
              <span class="goal-brand-ielts">IELTS</span>
              <span class="goal-brand-simplified">SIMPLIFIED</span>
            </div>

            <div class="goal-instruction-card" dir="rtl">
              <img class="goal-character" src={~p"/guy1.png"} alt="" draggable="false" />
              <p>
                قبل أن نتركك تبدأ، اختر <strong>هدفك</strong>
                في اختبار <span>IELTS</span>
                لكي نتابع تقدمك خطوة بخطوة <em>(تستطيع تغييره لاحقاً)</em>
              </p>
            </div>

            <div class="goal-sections" data-goal-sections>
              <section class="goal-card goal-card-writing" style="--skill-color: #35A7DF">
                <header class="goal-card-header">
                  <.icon name="hero-pencil-square-solid" class="goal-card-icon" />
                  <h2>Writing</h2>
                </header>
                <div class="goal-score-grid" aria-label="Writing score goal">
                  <button
                    :for={score <- ["6.0", "6.5", "7.0", "7.5", "8.0", "8.5+"]}
                    id={"goal-writing-#{String.replace(score, ".", "-") |> String.replace("+", "plus")}"}
                    type="button"
                    class="goal-score-button"
                    data-goal-skill="writing"
                    data-goal-score={score}
                    aria-pressed="false"
                  >
                    {score}
                  </button>
                </div>
              </section>

              <section class="goal-card goal-card-reading" style="--skill-color: #79C698">
                <header class="goal-card-header">
                  <.icon name="hero-book-open-solid" class="goal-card-icon" />
                  <h2>Reading</h2>
                </header>
                <div class="goal-score-grid" aria-label="Reading score goal">
                  <button
                    :for={score <- ["6.0", "6.5", "7.0", "7.5", "8.0", "8.5+"]}
                    id={"goal-reading-#{String.replace(score, ".", "-") |> String.replace("+", "plus")}"}
                    type="button"
                    class="goal-score-button"
                    data-goal-skill="reading"
                    data-goal-score={score}
                    aria-pressed="false"
                  >
                    {score}
                  </button>
                </div>
              </section>

              <section class="goal-card goal-card-speaking" style="--skill-color: #8E81F2">
                <header class="goal-card-header">
                  <.icon name="hero-chat-bubble-left-right-solid" class="goal-card-icon" />
                  <h2>Speaking</h2>
                </header>
                <div class="goal-score-grid" aria-label="Speaking score goal">
                  <button
                    :for={score <- ["6.0", "6.5", "7.0", "7.5", "8.0", "8.5+"]}
                    id={"goal-speaking-#{String.replace(score, ".", "-") |> String.replace("+", "plus")}"}
                    type="button"
                    class="goal-score-button"
                    data-goal-skill="speaking"
                    data-goal-score={score}
                    aria-pressed="false"
                  >
                    {score}
                  </button>
                </div>
              </section>

              <section class="goal-card goal-card-listening" style="--skill-color: #647FE8">
                <header class="goal-card-header">
                  <.icon name="hero-speaker-wave-solid" class="goal-card-icon" />
                  <h2>Listening</h2>
                </header>
                <div class="goal-score-grid" aria-label="Listening score goal">
                  <button
                    :for={score <- ["6.0", "6.5", "7.0", "7.5", "8.0", "8.5+"]}
                    id={"goal-listening-#{String.replace(score, ".", "-") |> String.replace("+", "plus")}"}
                    type="button"
                    class="goal-score-button"
                    data-goal-skill="listening"
                    data-goal-score={score}
                    aria-pressed="false"
                  >
                    {score}
                  </button>
                </div>
              </section>
            </div>

            <div class="goal-actions" dir="rtl">
              <button id="ielts-goal-skip" type="button" class="goal-action goal-action-skip">
                تخطي
              </button>
              <button
                id="ielts-goal-start"
                type="button"
                class="goal-action goal-action-start"
                disabled
                aria-disabled="true"
              >
                ابدأ
              </button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div id="main-app-content">
      {@inner_content}
    </div>
  </body>
</html>
